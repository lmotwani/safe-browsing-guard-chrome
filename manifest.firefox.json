{
  "manifest_version": 3,
  "name": "Safe Browsing Guard",
  "version": "2.0.0",
  "description": "Advanced protection against phishing, typosquatting, homograph attacks, and malicious downloads with real-time threat intelligence.",

  "browser_specific_settings": {
    "gecko": {
      "id": "safe-browsing-guard@extension.org",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Safe Browsing Guard"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
